{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mcp_server",
            "type": "debugpy",
            "request": "launch",
            "module": "mcp_server.run",
            "console": "integratedTerminal",
            "env": {
                "PUBLIC_BASE_URL": "http://localhost:8200",
                "DATA_DIR": "${workspaceFolder}/mcp_server/data",
                "EXPORTS_DIR": "${workspaceFolder}/mcp_server/data/exports"
            }
        }
    ]
}
